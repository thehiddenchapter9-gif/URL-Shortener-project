# Server
PORT=3000
NODE_ENV=development
# Public base URL used to build short links (shortUrl in API responses).
BASE_URL=http://localhost:3000

# PostgreSQL
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=url_shortener
PG_POOL_MAX=10

# Redis
REDIS_URL=redis://localhost:6379
REDIS_CACHE_TTL_SECONDS=3600

# Short code generation
SHORT_CODE_LENGTH=6

# Logging: error | warn | info | http | debug
LOG_LEVEL=info

# Rate limiting for POST /api/shorten
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=30
